# ── Admin security (MUSK Store) ────────────────────────────────────────────
# ADMIN_PASSWORD: Plaintext fallback used ONLY ON FIRST BOOTSTRAP.
#   On first successful login with this value, it gets auto-hashed with bcrypt
#   and stored in settings.json. NEVER commit this to git.
#   After the first login, you can remove it from .env or leave it — it will
#   only be used if adminPasswordHash is absent from settings.json.
ADMIN_PASSWORD="CHANGE_ME_ON_FIRST_BOOT"

# ADMIN_PASSWORD_HASH: Optional — pre-computed bcrypt hash of the admin password.
#   If present, this takes priority over ADMIN_PASSWORD. You can generate a
#   hash on your machine with:  node -e "console.log(require('bcryptjs').hashSync('YOUR_PW', 12))"
# ADMIN_PASSWORD_HASH=""

# ADMIN_GMAIL_1 / ADMIN_GMAIL_2: The only two emails permitted to log into
#   the Admin Panel. Can also be changed later from the Admin UI after login.
ADMIN_GMAIL_1=""
ADMIN_GMAIL_2=""

# SESSION_SECRET: 256-bit random secret used to sign admin session tokens.
#   Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   KEEP THIS SECRET! If it leaks, invalidate all sessions.
SESSION_SECRET="replace-with-a-long-random-string"

# ── Runtime / deployment ────────────────────────────────────────────────────
# APP_URL: The public URL where the storefront is hosted (used for self-links,
# OAuth callbacks, etc.). Leave blank in dev.
APP_URL=""

# NODE_ENV: 'production' enables secure cookies, stricter CORS, and the
# bundled static server. Anything else runs Vite middleware + HMR.
NODE_ENV="development"

# PORT: Server port (default 3000)
# PORT="3000"

# ALLOWED_ORIGINS: Comma-separated list of origins permitted by CORS.
#   Leave blank in dev (localhost is always allowed). Example:
# ALLOWED_ORIGINS="https://themuskgadgets.com,https://www.themuskgadgets.com"

# ── Google / Firebase (Google Drive manager in Admin Panel) ──────────────────
GEMINI_API_KEY=""

# ── Public-facing config (not secret, only for server defaults) ──────────────
# OWNER_WHATSAPP: Your store owner's WhatsApp number in international format
#   without the leading +. Defaults to empty; set this from Admin Panel later.
OWNER_WHATSAPP=""

# ── Database (optional — enables persistence on hosts with ephemeral disk) ─
# DATABASE_URL: A MySQL connection string. When set, settings + analytics are
#   stored in a `kv` table in MySQL instead of settings.json / analytics.json.
#   This is REQUIRED on Render/Railway (ephemeral filesystem).
#   Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME
#   On first boot the table is created automatically.
#   Free MySQL options: TiDB Cloud (5GB, no card), Aiven, db4free.
DATABASE_URL=""
